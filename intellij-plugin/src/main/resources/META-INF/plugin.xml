<?xml version="1.0" encoding="UTF-8"?>
<!-- Plugin Configuration File.  See https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>

    <!-- ===== Basic metadata ===== -->
    <id>de.fraunhofer.iem.safe</id>
    <name>SAFE</name>
    <vendor url="https://www.iem.fraunhofer.de/">Fraunhofer IEM</vendor>

    <description><![CDATA[
    Enter short description for your plugin here.
<em>Most HTML tags may be used.</em>
  ]]></description>

    <!-- Platform dependency -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- ===== Extensions & listeners ===== -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool-window registration -->
        <toolWindow id="SAFE"
                    anchor="bottom"
                    factoryClass="de.fraunhofer.iem.safe.ExplainerToolWindowFactory"
                    icon="/icons/toolWindowChat.svg"/>
    </extensions>

    <!-- Project-level listener -->
    <projectListeners>
        <listener
                class="de.fraunhofer.iem.safe.problems.ProblemsListener"
                topic="com.intellij.analysis.problemsView.ProblemsListener"/>
    </projectListeners>

    <!-- ===== Actions ===== -->
    <actions>

        <!-- Top-level group under Tools -->
        <group id="FixMySast.Actions" text="SAFE" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="Safe.ExplainVulnerabilityAction"
                    class="de.fraunhofer.iem.safe.actions.ExplainVulnerabilityAction"
                    text="Explain Vulnerability"
                    description="Get an AI explanation of the selected vulnerability"
                    icon="/icons/toolWindowChat.svg">
                <add-to-group group-id="ProblemsView.ToolWindow.TreePopup" anchor="last"/>
            </action>
        </group>

    </actions>
</idea-plugin>