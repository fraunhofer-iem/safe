<?xml version="1.0" encoding="UTF-8"?>
<!-- Plugin Configuration File.  See https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>

    <!-- ===== Basic metadata ===== -->
    <id>de.fraunhofer.iem.safe</id>
    <name>SAFE</name>
    <vendor url="https://www.iem.fraunhofer.de/">Fraunhofer IEM</vendor>

    <description><![CDATA[
    Enter short description for your plugin here.
<em>Most HTML tags may be used.</em>
  ]]></description>

    <!-- Platform dependency -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- ===== Extensions & listeners ===== -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool-window registration -->
        <toolWindow id="SAFE"
                    anchor="bottom"
                    factoryClass="de.fraunhofer.iem.safe.ExplainerToolWindowFactory"
                    icon="/icons/toolWindowChat.svg"/>

        <!-- Auto-restore the last imported SARIF file on project open -->
        <postStartupActivity implementation="de.fraunhofer.iem.safe.SafeStartupActivity"/>

        <!-- Tools | SAFE settings page (provider, endpoint, model, key) -->
        <applicationConfigurable
            parentId="tools"
            id="de.fraunhofer.iem.safe.settings"
            displayName="SAFE"
            instance="de.fraunhofer.iem.safe.settings.SafeSettingsConfigurable"/>
    </extensions>

    <!-- Project-level listener -->
    <projectListeners>
        <listener class="de.fraunhofer.iem.safe.ui.VulnerabilityEditorListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>

    </projectListeners>

    <!-- ===== Actions ===== -->
    <actions>

        <!-- Top-level group under Tools -->
        <group id="FixMySast.Actions" text="SAFE" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="Safe.ExplainVulnerabilityAction"
                    class="de.fraunhofer.iem.safe.actions.ExplainVulnerabilityAction"
                    text="Explain Vulnerability"
                    description="Get an AI explanation of the selected vulnerability"
                    icon="/icons/toolWindowChat.svg">
                <add-to-group group-id="ProblemsView.ToolWindow.TreePopup" anchor="last"/>
            </action>

            <action id="Safe.ImportAllProblemsAction"
                    class="de.fraunhofer.iem.safe.actions.ImportProblemsAction"
                    text="Import All Problems..."
                    description="Import all findings from the Qodana plugin's SARIF output or a SARIF file"
                    icon="AllIcons.ToolbarDecorator.Import"/>
        </group>

    </actions>
</idea-plugin>