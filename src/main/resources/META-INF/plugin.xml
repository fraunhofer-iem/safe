<?xml version="1.0" encoding="UTF-8"?>
<!-- Plugin Configuration File.  See https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin version="2">

    <!-- ===== Basic metadata ===== -->
    <id>de.fraunhofer.iem.fixmysast</id>
    <name>FixMySAST</name>
    <vendor url="https://www.yourcompany.com">YourCompany</vendor>

    <description><![CDATA[
    Enter short description for your plugin here.
<em>Most HTML tags may be used.</em>
  ]]></description>

    <!-- Platform dependency -->
    <depends>com.intellij.modules.platform</depends>

    <!-- ===== Extensions & listeners ===== -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool-window registration -->
        <toolWindow
                id="MyToolWindow"
                factoryClass="de.fraunhofer.iem.fixmysast.toolWindow.MyToolWindowFactory"
                anchor="right"
                secondary="false"/>

    </extensions>

    <!-- Project-level listener -->
    <projectListeners>
        <listener
                class="de.fraunhofer.iem.fixmysast.ProblemsListener"
                topic="com.intellij.analysis.problemsView.ProblemsListener"/>
    </projectListeners>

    <!-- ===== Actions ===== -->
    <actions>

        <!-- Top-level group under Tools -->
        <group id="FixMySASTGroup" text="FixMySAST" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <!-- Main “Run analysis” action -->
            <action id="FixMySAST.Run"
                    class="de.fraunhofer.iem.fixmysast.actions.FixMySASTAction"
                    text="Run Analysis"
                    description="Run SAST analysis and get LLM explanation"/>

            <action id="FixMySAST.Import"
                    class="de.fraunhofer.iem.fixmysast.actions.ImportFileAction"
                    text="Import File"
                    icon="AllIcons.ToolbarDecorator.Import"
                    description="Import SARIF file"/>

            <!-- Level submenu (radio buttons) -->
            <action id="FixMySAST.LevelGroup"
                    class="de.fraunhofer.iem.fixmysast.actions.LevelActionGroup"
                    text="Level"/>
        </group>

    </actions>
</idea-plugin>