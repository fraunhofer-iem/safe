<?xml version="1.0" encoding="UTF-8"?>
<!-- Plugin Configuration File.  See https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>

    <!-- ===== Basic metadata ===== -->
    <id>de.fraunhofer.iem.fixmysast</id>
    <name>SAFE</name>
    <vendor url="https://www.iem.fraunhofer.de/">Fraunhofer IEM</vendor>

    <description><![CDATA[
    Enter short description for your plugin here.
<em>Most HTML tags may be used.</em>
  ]]></description>

    <!-- Platform dependency -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- ===== Extensions & listeners ===== -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool-window registration -->
        <toolWindow
                id="SAFE"
                factoryClass="de.fraunhofer.iem.fixmysast.ExplanationToolWindow"
                icon="AllIcons.Toolwindows.Documentation"
                anchor="right"
                secondary="false"/>
    </extensions>

    <!-- Project-level listener -->
    <projectListeners>
        <listener
                class="de.fraunhofer.iem.fixmysast.problems.ProblemsListener"
                topic="com.intellij.analysis.problemsView.ProblemsListener"/>
    </projectListeners>

    <!-- ===== Actions ===== -->
    <actions>

        <!-- Top-level group under Tools -->
        <group id="FixMySast.Actions" text="SAFE" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <!-- Main “Run analysis” action -->
            <action id="FixMySAST.Import"
                    class="de.fraunhofer.iem.fixmysast.actions.ImportFileAction"
                    text="Import File"
                    icon="AllIcons.ToolbarDecorator.Import"
                    description="Import SARIF file"/>

            <action id="FixMySAST.LevelSliderAction"
                    class="de.fraunhofer.iem.fixmysast.actions.LevelSliderAction"
                    icon="AllIcons.Actions.More"
                    text="Set Expertise Level"/>
        </group>

    </actions>
</idea-plugin>