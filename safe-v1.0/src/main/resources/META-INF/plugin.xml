<?xml version="1.0" encoding="UTF-8"?>
<!-- Plugin Configuration File.  See https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>

    <!-- ===== Basic metadata ===== -->
    <id>de.fraunhofer.iem.safe.blue</id>
    <name>SAFE-Blue</name>
    <vendor url="https://www.iem.fraunhofer.de/">Fraunhofer IEM</vendor>

    <description><![CDATA[
    Enter short description for your plugin here.
<em>Most HTML tags may be used.</em>
  ]]></description>

    <!-- Platform dependency -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- ===== Extensions & listeners ===== -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool-window registration -->
        <toolWindow
                id="SAFE-Blue"
                factoryClass="de.fraunhofer.iem.safe.blue.ExplanationToolWindow"
                icon="/icons/toolWindowChat.svg"
                anchor="bottom"
                secondary="false"/>

        <!-- Tools | SAFE-Blue settings page (platform, endpoint, model, temperature, key) -->
        <applicationConfigurable
                parentId="tools"
                id="de.fraunhofer.iem.safe.settings.blue"
                displayName="SAFE-Blue"
                instance="de.fraunhofer.iem.safe.blue.settings.SafeSettingsConfigurable"/>

        <!-- Balloon notifications surface plugin events. -->
        <notificationGroup id="SAFE-Blue"
                           displayType="BALLOON"/>

        <!-- Study-mode editor telemetry — bound to a per-project service so it
             lives exactly as long as the project. -->
        <postStartupActivity implementation="de.fraunhofer.iem.safe.blue.study.StudyEditorListener$StartupActivity"/>
    </extensions>

    <!-- Project-level listener -->
    <projectListeners>
        <listener
                class="de.fraunhofer.iem.safe.blue.problems.ProblemsListener"
                topic="com.intellij.analysis.problemsView.ProblemsListener"/>
    </projectListeners>

    <!-- ===== Actions ===== -->
    <actions>

        <!-- Top-level group under Tools — id is suffixed with `.Blue` so the
             two SAFE plugin variants can coexist in the same IDE without
             colliding on action-system identifiers. -->
        <group id="Safe.Actions.Blue" text="SAFE-Blue" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="Safe.Import.Blue"
                    class="de.fraunhofer.iem.safe.blue.actions.ImportFileAction"
                    text="Import File"
                    icon="AllIcons.ToolbarDecorator.Import"
                    description="Import SARIF file"/>

            <group id="Safe.LevelSliderAction.Blue"
                   class="de.fraunhofer.iem.safe.blue.actions.LevelSliderAction"
                   icon="AllIcons.Actions.More"
                   text="Set Expertise Level"
                   description="Pick an expertise level for the explanations"
                   popup="true"/>

            <action id="Safe.OpenSettings.Blue"
                    class="de.fraunhofer.iem.safe.blue.actions.OpenSafeSettingsAction"
                    icon="AllIcons.General.Settings"
                    text="SAFE-Blue Settings"
                    description="Configure the SAFE-Blue plugin's LLM platform, endpoint, model, and API key"/>

            <!-- Visible only when study mode is enabled — see PrewarmExplanationsAction.update(). -->
            <action id="Safe.PrewarmExplanations.Blue"
                    class="de.fraunhofer.iem.safe.blue.actions.PrewarmExplanationsAction"
                    icon="AllIcons.Actions.Compile"
                    text="Pre-warm Explanations"
                    description="Generate Intermediate-level explanations for every imported finding (study mode)"/>
        </group>

    </actions>
</idea-plugin>
