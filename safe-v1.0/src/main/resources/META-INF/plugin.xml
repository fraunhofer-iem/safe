<?xml version="1.0" encoding="UTF-8"?>
<!-- Plugin Configuration File.  See https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>

    <!-- ===== Basic metadata ===== -->
    <id>de.fraunhofer.iem.safe</id>
    <name>SAFE</name>
    <vendor url="https://www.iem.fraunhofer.de/">Fraunhofer IEM</vendor>

    <description><![CDATA[
    Enter short description for your plugin here.
<em>Most HTML tags may be used.</em>
  ]]></description>

    <!-- Platform dependency -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>

    <!-- ===== Extensions & listeners ===== -->
    <extensions defaultExtensionNs="com.intellij">

        <!-- Tool-window registration -->
        <toolWindow
                id="SAFE-Blue"
                factoryClass="de.fraunhofer.iem.safe.ExplanationToolWindow"
                icon="/icons/toolWindowChat.svg"
                anchor="bottom"
                secondary="false"/>

        <!-- Tools | SAFE settings page (platform, endpoint, model, temperature, key) -->
        <applicationConfigurable
                parentId="tools"
                id="de.fraunhofer.iem.safe.settings"
                displayName="SAFE"
                instance="de.fraunhofer.iem.safe.settings.SafeSettingsConfigurable"/>

        <!-- Study-mode editor telemetry — bound to a per-project service so it
             lives exactly as long as the project. -->
        <postStartupActivity implementation="de.fraunhofer.iem.safe.study.StudyEditorListener$StartupActivity"/>
    </extensions>

    <!-- Project-level listener -->
    <projectListeners>
        <listener
                class="de.fraunhofer.iem.safe.problems.ProblemsListener"
                topic="com.intellij.analysis.problemsView.ProblemsListener"/>
    </projectListeners>

    <!-- ===== Actions ===== -->
    <actions>

        <!-- Top-level group under Tools -->
        <group id="FixMySast.Actions" text="SAFE" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <!-- Main “Run analysis” action -->
            <action id="FixMySAST.Import"
                    class="de.fraunhofer.iem.safe.actions.ImportFileAction"
                    text="Import File"
                    icon="AllIcons.ToolbarDecorator.Import"
                    description="Import SARIF file"/>

            <group id="FixMySAST.LevelSliderAction"
                   class="de.fraunhofer.iem.safe.actions.LevelSliderAction"
                   icon="AllIcons.Actions.More"
                   text="Set Expertise Level"
                   description="Pick an expertise level for the explanations"
                   popup="true"/>

            <action id="FixMySAST.OpenSettings"
                    class="de.fraunhofer.iem.safe.actions.OpenSafeSettingsAction"
                    icon="AllIcons.General.Settings"
                    text="SAFE Settings"
                    description="Configure the SAFE plugin's LLM platform, endpoint, model, and API key"/>

            <!-- Visible only when study mode is enabled — see PrewarmExplanationsAction.update(). -->
            <action id="FixMySAST.PrewarmExplanations"
                    class="de.fraunhofer.iem.safe.actions.PrewarmExplanationsAction"
                    icon="AllIcons.Actions.Compile"
                    text="Pre-warm Explanations"
                    description="Generate Intermediate-level explanations for every imported finding (study mode)"/>
        </group>

    </actions>
</idea-plugin>