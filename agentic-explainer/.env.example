# Copy to .env and fill in. The service's default LLM lives behind Azure OpenAI
# (used when the plugin doesn't override per request), so all four AZURE_*
# variables are required for the default path to work.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-key>
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>

# Optional: Langfuse tracing. The CallbackHandler instantiates without these,
# but it will warn at startup. Comment out the langfuse_handler in fastapi_main.py
# if you don't want tracing at all.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: directory (or single file) of Semgrep-format YAML rules. When set,
# the agent's `lookup_sast_rule` tool can read the actual rule definition for a
# finding's `rule_id`, so explanations reflect what the rule really checks
# instead of guessing from the id. Leave unset to disable the tool.
# SAST_RULES_PATH=/path/to/semgrep-rules
